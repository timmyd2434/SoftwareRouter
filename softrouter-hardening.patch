+func TestOpenVPNAllowlistRejectsDangerous(t *testing.T) {
+	bad := []string{
+		"plugin /tmp/evil.so", "up /tmp/x.sh", "down /tmp/x.sh", "route-up /bin/sh",
+		"auth-user-pass-verify /x via-env", "tls-verify /x", "script-security 2",
